{
  "name": "acr122u-agent",
  "version": "0.1.0",
  "description": "Standalone cross-platform background agent for the ACR122U-A9 NFC reader over PC/SC with a local WebSocket server",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "nfc-pcsc": "^0.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
